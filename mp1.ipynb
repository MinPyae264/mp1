    receiver1[mask1],
    receiver2[mask1]
)[0, 1]

# Approximate standard error for Pearson correlation
def corr_se(r, n):
    return np.sqrt(
        (1 - r**2) / (n - 2)
    )

se_all = corr_se(
    r_all,
    len(receiver1)
)

se_0 = corr_se(
    r_0,
    np.sum(mask0)
)

se_1 = corr_se(
